{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/tour.schema.json",
    "title": "Tour",
    "description": "Virtual tour with 360-degree panoramic scenes linked to a specific unit model",
    "type": "object",
    "properties": {
        "tourId": {
            "type": "string",
            "description": "Unique identifier for this tour"
        },
        "modelId": {
            "type": [
                "string",
                "null"
            ],
            "description": "Reference to the model ID this tour represents, or null for non-unit tours (e.g., street view)"
        },
        "projectId": {
            "type": "string",
            "description": "Project identifier"
        },
        "startSceneId": {
            "type": "string",
            "description": "Deprecated: use startingSceneId instead"
        },
        "startingSceneId": {
            "type": "string",
            "description": "ID of the starting scene"
        },
        "scenes": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/PanoScene"
            },
            "minItems": 1
        },
        "metadata": {
            "$ref": "#/definitions/TourMetadata"
        }
    },
    "required": [
        "modelId",
        "scenes"
    ],
    "additionalProperties": false,
    "definitions": {
        "PanoScene": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "image": {
                    "type": "string",
                    "description": "Deprecated: use panoramaImage instead"
                },
                "panoramaImage": {
                    "$ref": "#/definitions/PanoramaImage"
                },
                "name": {
                    "type": "string",
                    "description": "Optional display name for the scene"
                },
                "links": {
                    "type": "array",
                    "description": "Deprecated: use hotspots instead",
                    "items": {
                        "$ref": "#/definitions/PanoLink"
                    }
                },
                "hotspots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/PanoHotspot"
                    }
                },
                "initialView": {
                    "type": "object",
                    "properties": {
                        "yaw": {
                            "type": "number"
                        },
                        "pitch": {
                            "type": "number"
                        },
                        "fov": {
                            "type": "number",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id"
            ],
            "oneOf": [
                {
                    "required": [
                        "image"
                    ]
                },
                {
                    "required": [
                        "panoramaImage"
                    ]
                }
            ],
            "additionalProperties": false
        },
        "PanoLink": {
            "type": "object",
            "properties": {
                "target": {
                    "type": "string"
                },
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            },
            "required": [
                "target",
                "x",
                "y"
            ],
            "additionalProperties": false
        },
        "PanoHotspot": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "targetSceneId": {
                    "type": "string"
                },
                "position": {
                    "type": "object",
                    "properties": {
                        "yaw": {
                            "type": "number"
                        },
                        "pitch": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "yaw",
                        "pitch"
                    ],
                    "additionalProperties": false
                },
                "icon": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "targetSceneId",
                "position",
                "icon"
            ],
            "additionalProperties": false
        },
        "PanoramaImage": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string"
                },
                "filename": {
                    "type": "string"
                }
            },
            "required": [
                "url",
                "filename"
            ],
            "additionalProperties": false
        },
        "TourMetadata": {
            "type": "object",
            "properties": {
                "exportDate": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "sceneCount": {
                    "type": "number"
                },
                "totalHotspots": {
                    "type": "number"
                }
            },
            "required": [
                "exportDate",
                "version",
                "sceneCount",
                "totalHotspots"
            ],
            "additionalProperties": false
        }
    }
}