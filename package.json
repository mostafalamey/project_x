{
    "name": "project_x-interactive-viewer",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "server": "cd server && npm start",
        "dev:all": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
        "build": "vite build",
        "build:prod": "powershell -Command \"Copy-Item src/routes/index.production.tsx src/routes/index.tsx -Force\" && vite build --config vite.config.production.ts && powershell -Command \"git checkout src/routes/index.tsx 2>$null; if ($LASTEXITCODE -ne 0) { Write-Host 'Routes file unchanged' }\"",
        "build:prod:preview": "powershell -Command \"$env:VITE_BASE_PATH='/'; Copy-Item src/routes/index.production.tsx src/routes/index.tsx -Force\" && vite build --config vite.config.production.ts && powershell -Command \"git checkout src/routes/index.tsx 2>$null; if ($LASTEXITCODE -ne 0) { Write-Host 'Routes file unchanged' }\"",
        "build:github": "npm run build:prod && powershell -Command \"Copy-Item .nojekyll dist/.nojekyll\"",
        "preview": "vite preview",
        "preview:prod": "npm run build:prod:preview && vite preview",
        "lint": "eslint ./src --ext .ts,.tsx"
    },
    "engines": {
        "node": ">=18.17.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@photo-sphere-viewer/core": "^5.14.0",
        "@photo-sphere-viewer/markers-plugin": "^5.14.0",
        "@types/three": "^0.180.0",
        "dexie": "^4.2.1",
        "file-saver": "^2.0.5",
        "framer-motion": "^11.0.0",
        "i18next": "^25.6.0",
        "i18next-browser-languagedetector": "^8.2.0",
        "i18next-http-backend": "^3.0.2",
        "jszip": "^3.10.1",
        "konva": "^9.3.22",
        "lucide-react": "^0.546.0",
        "photo-sphere-viewer": "^4.0.8",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-dropzone": "^14.3.8",
        "react-i18next": "^16.2.1",
        "react-konva": "^18.2.14",
        "react-photo-sphere-viewer": "^2.1.4",
        "react-router-dom": "^6.25.1",
        "three": "^0.180.0",
        "use-image": "^1.1.4",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@types/file-saver": "^2.0.7",
        "@types/jszip": "^3.4.0",
        "@types/node": "^20.11.30",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vitejs/plugin-react": "^4.2.1",
        "ajv": "^8.12.0",
        "autoprefixer": "^10.4.17",
        "concurrently": "^9.2.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-react": "^7.34.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.7",
        "typescript": "5.3.3",
        "vite": "^7.1.11"
    }
}
