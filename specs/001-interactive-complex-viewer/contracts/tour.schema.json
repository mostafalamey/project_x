{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/tour.schema.json",
    "title": "Tour",
    "description": "Virtual tour with 360-degree panoramic scenes linked to a specific unit model",
    "type": "object",
    "properties": {
        "modelId": {
            "type": [
                "string",
                "null"
            ],
            "description": "Reference to the model ID this tour represents, or null for non-unit tours (e.g., street view)"
        },
        "startSceneId": {
            "type": "string"
        },
        "scenes": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/PanoScene"
            },
            "minItems": 1
        }
    },
    "required": [
        "modelId",
        "scenes"
    ],
    "additionalProperties": false,
    "definitions": {
        "PanoScene": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "image": {
                    "type": "string"
                },
                "links": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "target": {
                                "type": "string"
                            },
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "target",
                            "x",
                            "y"
                        ],
                        "additionalProperties": false
                    }
                },
                "initialView": {
                    "type": "object",
                    "properties": {
                        "yaw": {
                            "type": "number"
                        },
                        "pitch": {
                            "type": "number"
                        },
                        "fov": {
                            "type": "number",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "image"
            ],
            "additionalProperties": false
        }
    }
}