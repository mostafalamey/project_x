{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/masterplan.schema.json",
    "title": "MasterPlan",
    "type": "object",
    "properties": {
        "angles": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/MasterPlanAngle"
            },
            "minItems": 1
        },
        "buildings": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/MasterPlanBuilding"
            },
            "minItems": 1
        },
        "tourPoints": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/TourPoint"
            },
            "minItems": 0
        }
    },
    "required": [
        "angles",
        "buildings"
    ],
    "additionalProperties": false,
    "definitions": {
        "MasterPlanAngle": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "image": {
                    "type": "string"
                },
                "sequenceToNext": {
                    "$ref": "#/definitions/MasterPlanSequence"
                },
                "hotspots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MasterPlanHotspot"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "id",
                "image",
                "hotspots"
            ],
            "additionalProperties": false
        },
        "MasterPlanSequence": {
            "type": "object",
            "properties": {
                "folder": {
                    "type": "string"
                },
                "frameCount": {
                    "type": "integer",
                    "minimum": 1
                },
                "filenamePattern": {
                    "type": "string"
                }
            },
            "required": [
                "folder",
                "frameCount"
            ],
            "additionalProperties": false
        },
        "MasterPlanHotspot": {
            "type": "object",
            "properties": {
                "buildingId": {
                    "type": "string"
                },
                "polygons": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 6
                    },
                    "minItems": 1,
                    "maxItems": 4
                }
            },
            "required": [
                "buildingId",
                "polygons"
            ],
            "additionalProperties": false
        },
        "MasterPlanBuilding": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "summary": {
                    "type": "object",
                    "properties": {
                        "totalFloors": {
                            "type": "integer"
                        },
                        "availableUnits": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "totalFloors",
                        "availableUnits"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "name",
                "summary"
            ],
            "additionalProperties": false
        },
        "TourPoint": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "positions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/TourPointPosition"
                    },
                    "minItems": 1
                },
                "panoramicImage": {
                    "type": "string"
                },
                "initialView": {
                    "$ref": "#/definitions/TourPointInitialView"
                }
            },
            "required": [
                "id",
                "name",
                "positions",
                "panoramicImage",
                "initialView"
            ],
            "additionalProperties": false
        },
        "TourPointPosition": {
            "type": "object",
            "properties": {
                "angleIndex": {
                    "type": "integer",
                    "minimum": 0
                },
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            },
            "required": [
                "angleIndex",
                "x",
                "y"
            ],
            "additionalProperties": false
        },
        "TourPointInitialView": {
            "type": "object",
            "properties": {
                "yaw": {
                    "type": "number"
                },
                "pitch": {
                    "type": "number"
                },
                "fov": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 180
                }
            },
            "required": [
                "yaw",
                "pitch",
                "fov"
            ],
            "additionalProperties": false
        }
    }
}