{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/landmarks.schema.json",
    "title": "Landmarks",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string"
            },
            "name": {
                "type": "string"
            },
            "category": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "image": {
                "type": "string"
            },
            "distanceK": {
                "type": "number",
                "description": "Distance in kilometers"
            },
            "timeMin": {
                "type": "number",
                "description": "Walking time in minutes"
            },
            "coords": {
                "oneOf": [
                    {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "x",
                            "y"
                        ],
                        "additionalProperties": false
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 6
                    }
                ]
            },
            "path": {
                "type": "array",
                "items": {
                    "type": "number"
                },
                "minItems": 4,
                "description": "Array of x,y coordinates representing a path"
            },
            "pathStyle": {
                "type": "object",
                "properties": {
                    "stroke": {
                        "type": "string",
                        "description": "Stroke color in hex format"
                    },
                    "strokeWidth": {
                        "type": "number",
                        "description": "Stroke width in pixels"
                    }
                },
                "additionalProperties": false
            },
            "type": {
                "type": "string",
                "enum": [
                    "complex",
                    "poi"
                ]
            }
        },
        "required": [
            "id",
            "name",
            "coords",
            "type"
        ],
        "additionalProperties": false
    }
}