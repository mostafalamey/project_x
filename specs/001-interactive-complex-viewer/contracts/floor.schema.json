{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/floor.schema.json",
    "title": "Floor",
    "description": "Floor plan with unit hotspots. Tooltip data is derived from unit and model data at runtime.",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "description": "Floor identifier"
        },
        "name": {
            "type": "string",
            "description": "Floor name (e.g., 'Ground Floor')"
        },
        "floorNumber": {
            "type": "integer",
            "description": "Floor number"
        },
        "buildingId": {
            "type": "string",
            "description": "Building identifier this floor belongs to"
        },
        "buildingName": {
            "type": "string",
            "description": "Building name"
        },
        "floorPlanImage": {
            "type": "string",
            "description": "Path to the floor plan image"
        },
        "units": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/UnitHotspot"
            },
            "minItems": 0,
            "description": "Interactive unit hotspots on the floor plan"
        }
    },
    "required": [
        "id",
        "name",
        "floorNumber",
        "buildingId",
        "buildingName",
        "floorPlanImage",
        "units"
    ],
    "additionalProperties": false,
    "definitions": {
        "UnitHotspot": {
            "type": "object",
            "description": "Interactive polygon hotspot for a unit on the floor plan",
            "properties": {
                "unitNumber": {
                    "type": "string",
                    "description": "Unit number"
                },
                "modelId": {
                    "type": "string",
                    "description": "Reference to the model ID"
                },
                "modelTitle": {
                    "type": "string",
                    "description": "Model title/name"
                },
                "availability": {
                    "type": "string",
                    "enum": [
                        "available",
                        "reserved",
                        "sold"
                    ],
                    "description": "Unit availability status"
                },
                "pricing": {
                    "type": "object",
                    "properties": {
                        "price": {
                            "type": "number",
                            "description": "Unit price"
                        }
                    },
                    "required": [
                        "price"
                    ],
                    "additionalProperties": false
                },
                "polygon": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "minItems": 6,
                    "description": "Polygon coordinates as flat array [x1,y1,x2,y2,...]"
                }
            },
            "required": [
                "unitNumber",
                "modelId",
                "modelTitle",
                "availability",
                "pricing",
                "polygon"
            ],
            "additionalProperties": false
        }
    }
}